PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/careerquest
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Used only by "npm run seed" to create the first admin account. Change them!
ADMIN_EMAIL=admin@careerquest.com
ADMIN_PASSWORD=ChangeMe@123
# Optional (not required to run the app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=
# Resume uploads (folder is created automatically; max size in MB)
UPLOAD_DIR=
MAX_RESUME_MB=2
